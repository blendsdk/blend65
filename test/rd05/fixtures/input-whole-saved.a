; Complete saved-only expert program; documented NMOS6510 ISA.
; Assemble from repo root: acme -f cbm -o /tmp/input-saved.prg this-file.a
; Companion ordinary source: input-saved-caller.blend.
; Entry080D via shipped RUN/SYS stub; owned RAM, no NMINV qualifier or installation.
; Bank0 via saved DDRA&FC, zero CIA2 PRA accesses; exact DDRA restored.
; Incoming P/SP, processor-port readbacks and borrowed03..06 restored.
; Main falls through; normal RTS returns to usable BASIC, no outgoing A/X/Y promise.
; Input C100..C102 stable; output C103..C104 observable, disjoint all owners.
; Saved input C110..C11A additionally stable, packed and disjoint.
; Whole payload725 = stub12+startup102+caller78+queries533; no padding.
; Trailing general20: platform captures7, source snapshot11/results2.
; Physical ZP02..0F is14 bytes; helper07 overlays a dead caller slot, counted once.
; External qualification RAM16 bytes is not emitted or compiler allocated.
; Bounded generated stack: startupP1 + query/helper returns4=5, no main call.
; The incoming two-byte SYS return is external baseline, not generated stack use.
; No generated NMI installation.
; Firmware reserve20 is capacity, not generated use; external aggregate Unknown.
; CPU cycles below count080D through final RTS, no VIC/RDY stalls or IRQ/NMI.
; Existing ROM bytes/cycles, retained-owner paths, STOP/nonreturning: Unknown.
; No whole time guarantee inferred from bounded generated instruction paths.
; Path all_high: 510 cycles, key/joy results1/1.
; Path invalid_arguments: 435 cycles, key/joy results2/2.
; Path one_key: 1323 cycles, key/joy results0/1.
; Path ghost_square: 1542 cycles, key/joy results2/1.
; Path joy1_single: 1731 cycles, key/joy results1/0.
; Path dual_ground: 1852 cycles, key/joy results2/2.
; Path absent_eligible: 628 cycles, key/joy results2/1.
; Path interrupted: 416 cycles, key/joy results2/2.
; Path unnamed_quality: 416 cycles, key/joy results2/2.
; Path invalid_control: 478 cycles, key/joy results1/2.
; Paths use key0/port1/control0 unless invalid arguments255/255 or control255.
; Raw objects: HIGH=FFx10; one_key=FE,FFx9; ghost=FC,FC,FFx8.
; joy1_single=FEx9,FF; dual_ground=FEx10; absent_eligible=DF,FFx8,DF.
; Saved quality0 unless interrupted1/unnamed255; absent_eligible key5.
; PBON=CRA bit1; all guards retain arbitrary unnamed enum values.
; Taken extra cycles at9A2/9AC/9B2/9D2/9DF in joystick guards.
; Other branches do not cross pages; all relative displacements fit [-128,127].
; Saved object offsets0..10 never cross page; constant C110,X reads do not cross.
!cpu 6502
* = $0801
!byte $0b,$08,$0a,$00,$9e,$32,$30,$36,$31,$00,$00,$00
!source "test/rd05/fixtures/input-startup.a"
main:
ldx #0
load_rows:
lda $c110,x
sta saved,x
inx
cpx #8
bne load_rows
lda $c118
sta saved+8
lda $c119
sta saved+9
lda $c11a
sta saved+10
lda #<saved
sta $02
lda #>saved
sta $03
lda $c100
sta $04
jsr key_state
sta key_result
lda $c101
sta $04
lda $c102
sta $05
jsr joystick_state
sta joystick_result
lda key_result
sta $c103
lda joystick_result
sta $c104
restore:
+restore_basic
!source "test/rd05/fixtures/input-query-key.a"
!source "test/rd05/fixtures/input-query-joystick.a"
!source "test/rd05/fixtures/input-query-compatibility.a"
!source "test/rd05/fixtures/input-query-sole-source.a"
payload_end = *
!if startup != $80d { !error "startup placement changed" }
!if main != $84c { !error "main placement changed" }
!if restore != $89a { !error "restore placement changed" }
!if key_state != $8c1 { !error "key_state placement changed" }
!if joystick_state != $99e { !error "joystick_state placement changed" }
!if compatible != $a28 { !error "compatible placement changed" }
!if sole_source != $ab6 { !error "sole_source placement changed" }
saved_ddr = payload_end
saved_port = saved_ddr+1
saved_cia2_ddra = saved_port+1
saved_basic_vectors = saved_cia2_ddra+1
saved = saved_basic_vectors+4
key_result = saved+11
joystick_result = key_result+1
bss_end = joystick_result+1
!if payload_end-$0801 != 725 { !error "Whole payload changed" }
!if bss_end-payload_end != 20 { !error "General ownership changed" }
!if (saved & $ff)+10 > $ff { !error "Saved page-cross assumption" }
; hidden-return specialization: unique stable saved address encoded once per store.
; No address-taken acquisition, second destination or alias requires generic fallback.
; Public pointer/scalar query arguments retain their source evaluation order.
