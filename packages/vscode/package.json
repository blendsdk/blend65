{
  "name": "@blend65/vscode",
  "displayName": "Blend65",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/extension.js",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "activationEvents": [
    "onLanguage:blend65",
    "onCommand:blend65.build",
    "onCommand:blend65.run",
    "onCommand:blend65.openEvidence"
  ],
  "contributes": {
    "languages": [
      {
        "id": "blend65",
        "extensions": [
          ".blend"
        ]
      }
    ],
    "commands": [
      {
        "command": "blend65.build",
        "title": "Blend65: Build"
      },
      {
        "command": "blend65.run",
        "title": "Blend65: Run in VICE"
      },
      {
        "command": "blend65.openEvidence",
        "title": "Blend65: Open Build Evidence"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "blend65.build",
          "when": "editorLangId == blend65"
        },
        {
          "command": "blend65.run",
          "when": "editorLangId == blend65"
        },
        {
          "command": "blend65.openEvidence",
          "when": "editorLangId == blend65"
        }
      ],
      "editor/title": [
        {
          "command": "blend65.build",
          "when": "editorLangId == blend65"
        },
        {
          "command": "blend65.run",
          "when": "editorLangId == blend65"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --build && vite build",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@blend65/language-server": "0.1.0",
    "vscode-languageclient": "10.1.1",
    "@blend65/cli": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "1.138.0",
    "vite": "5.4.21"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language analysis works without trust; build, run, and artifact reveal require a trusted workspace."
    }
  }
}
