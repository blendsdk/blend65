// 02-coalescing/non-overlapping.blend
// Tests: Basic coalescing of non-overlapping functions
// Expected: funcA and funcB share memory

module SFA.Test.NonOverlapping;

function main(): void {
    funcA();
    funcB();
}

function funcA(): void {
    let a1: byte = 1;
    let a2: byte = 2;
    let a3: byte = 3;
}

function funcB(): void {
    let b1: byte = 4;
    let b2: byte = 5;
}