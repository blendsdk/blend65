{
  "name": "@blend65/compiler",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "default": "./dist/frontend/index.js"
    },
    "./tools": {
      "types": "./dist/tools/tools-config.d.ts",
      "default": "./dist/tools/tools-config.js"
    }
  },
  "files": [
    "dist",
    "stdlib"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
