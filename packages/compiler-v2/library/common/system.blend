// ============================================================================
// System Built-In Functions (Compiler Intrinsics) - v2
// ============================================================================
// This module defines the 10 core built-in intrinsic functions.
// These are compiler intrinsics — they have no Blend implementation.
// The compiler generates optimized 6502 machine code directly.
//
// v2 Changes from v1:
// - Removed sizeof() (not in v2 spec)
// - Removed CPU ops (sei, cli, nop, brk) → now asm_sei(), asm_cli(), etc.
// - Removed stack ops (pha, pla, php, plp) → now asm_pha(), asm_pla(), etc.
// ============================================================================

module system;

// ============================================================================
// Memory Access Intrinsics (4 functions)
// ============================================================================

/** Read a byte from memory at the specified address. */
export function peek(address: word): byte;

/** Write a byte to memory at the specified address. */
export function poke(address: word, value: byte): void;

/** Read a word (16-bit) from memory at the specified address (little-endian). */
export function peekw(address: word): word;

/** Write a word (16-bit) to memory at the specified address (little-endian). */
export function pokew(address: word, value: word): void;

// ============================================================================
// Byte Extraction Intrinsics (2 functions)
// ============================================================================

/** Extract the low byte (bits 0-7) of a 16-bit word. */
export function lo(value: word): byte;

/** Extract the high byte (bits 8-15) of a 16-bit word. */
export function hi(value: word): byte;

// ============================================================================
// Compile-Time Intrinsics (1 function)
// ============================================================================

/** Get the number of elements in an array or characters in a string. */
export function length(value: byte[]): word;

// ============================================================================
// Optimizer Control Intrinsics (3 functions)
// ============================================================================

/** Insert an optimization barrier (no code generated). */
export function barrier(): void;

/** Perform a volatile memory read that cannot be optimized away. */
export function volatile_read(address: word): byte;

/** Perform a volatile memory write that cannot be optimized away. */
export function volatile_write(address: word, value: byte): void;
