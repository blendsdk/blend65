{
  "name": "@blend65/readiness-execution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "tsc --build",
    "test": "vitest run",
    "pretest:smoke": "tsc --build",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "pretest:coverage": "tsc --build",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rd05": "vitest run --config vitest.rd05.config.ts --coverage",
    "generate:execution-bindings": "tsc --build && node ../../scripts/gen-execution-bindings.mjs --write && tsc --build",
    "check:execution-bindings": "node ../../scripts/gen-execution-bindings.mjs --check",
    "execute": "node dist/execution-cli-entry.js"
  },
  "dependencies": {
    "@blend65/cli": "0.1.0",
    "@blend65/compiler": "0.1.0",
    "@blend65/core": "0.1.0",
    "@blend65/frontend": "0.1.0",
    "@blend65/readiness": "0.1.0",
    "@blend65/test-harness": "0.1.0"
  }
}
