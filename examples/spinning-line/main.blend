// ============================================================================
// Spinning Line Sprite Animation
// ============================================================================
// Animates a sprite that cycles through 4 rotation frames: | / - \
// creating the illusion of a spinning line.
//
// This example demonstrates:
//   - Single multi-frame @sprite declaration (4 frames × 64 bytes)
//   - getSpriteFrame() library function for O(1) frame selection
//   - @ address-of operator passed as word function argument (Bug #1 fix)
//   - Word division inside functions: spriteAddr / 64 (Bug #2 fix)
//   - For-loop with byte counter up to 255 (Bug #3 fix)
//   - lo() intrinsic for word-to-byte narrowing
//   - VIC-II sprite pointer arithmetic
//
// Animation sequence: | → / → - → \ → | → / → - → \ → ...
//
// Multi-Frame Sprite Sheet:
//   Each frame occupies exactly 64 bytes (63 data + 1 padding).
//   The VIC-II reads sprites from 64-byte aligned blocks, so
//   contiguous frames have consecutive pointer values:
//     pointer_for_frame_N = (base_address / 64) + N
//
//   This matches the export format of SpritePad and Spritemate editors.
//
// C64 Sprite Facts:
//   - Each sprite is 24×21 pixels (3 bytes/row × 21 rows = 63 bytes)
//   - Sprite data lives in 64-byte aligned blocks
//   - The VIC-II reads sprite pointers from screen RAM + $03F8
//   - Pointer value = sprite_data_address / 64
//
// Module: SpinningLine
// Target: Commodore 64
// ============================================================================

module SpinningLine;

// ============================================================================
// VIC-II Registers
// ============================================================================

const VIC_SPRITE0_X: word = $D000;       // Sprite 0 X position (low 8 bits)
const VIC_SPRITE0_Y: word = $D001;       // Sprite 0 Y position
const VIC_SPRITE_X_MSB: word = $D010;    // X position MSB for all sprites
const VIC_SPRITE_ENABLE: word = $D015;   // Sprite enable register
const VIC_SPRITE0_COLOR: word = $D027;   // Sprite 0 individual color

// Sprite 0 pointer: default screen ($0400) + $03F8 + sprite index
const SPRITE0_POINTER: word = $07F8;

// ============================================================================
// Screen Position (center of visible area)
// ============================================================================
// VIC-II visible area starts at X=24, Y=50 and is 320×200 pixels.
// Center = (24 + 160, 50 + 100) = (184, 150)
// Sprite offset: 12px wide, 10px tall (half of 24×21)
// Centered: X = 184 - 12 = 172, Y = 150 - 10 = 140

const SPRITE_X: byte = 172;
const SPRITE_Y: byte = 140;

// ============================================================================
// Animation Constants
// ============================================================================

const NUM_FRAMES: byte = 4;       // Total animation frames: | / - \
const COLOR_WHITE: byte = 1;      // Sprite color

// ============================================================================
// Multi-Frame Sprite Sheet (4 frames × 64 bytes = 256 bytes)
// ============================================================================
// All 4 rotation frames stored contiguously in a single @sprite block.
// Each frame is exactly 64 bytes: 63 bytes of pixel data + 1 padding byte.
//
// This layout matches how sprite editors (SpritePad, Spritemate) export
// multi-frame sprites. A single @sprite directive means only ONE alignment
// gap, saving up to 189 bytes compared to 4 separate @sprite declarations.
//
// Memory layout:
//   base+0:   Frame 0 (|)   — 64 bytes
//   base+64:  Frame 1 (/)   — 64 bytes
//   base+128: Frame 2 (-)   — 64 bytes
//   base+192: Frame 3 (\)   — 64 bytes
//
// VIC-II pointer for frame N = (base / 64) + N

@sprite const lineFrames: byte[] = [
    // ================================================================
    // Frame 0: Vertical Line "|" (64 bytes)
    // ================================================================
    // 2-pixel wide vertical bar centered at columns 11-12.
    // All 21 rows: ........XX.......... → $00, $18, $00
    $00, $18, $00,       // Row 0
    $00, $18, $00,       // Row 1
    $00, $18, $00,       // Row 2
    $00, $18, $00,       // Row 3
    $00, $18, $00,       // Row 4
    $00, $18, $00,       // Row 5
    $00, $18, $00,       // Row 6
    $00, $18, $00,       // Row 7
    $00, $18, $00,       // Row 8
    $00, $18, $00,       // Row 9
    $00, $18, $00,       // Row 10
    $00, $18, $00,       // Row 11
    $00, $18, $00,       // Row 12
    $00, $18, $00,       // Row 13
    $00, $18, $00,       // Row 14
    $00, $18, $00,       // Row 15
    $00, $18, $00,       // Row 16
    $00, $18, $00,       // Row 17
    $00, $18, $00,       // Row 18
    $00, $18, $00,       // Row 19
    $00, $18, $00,       // Row 20
    $00,                 // Padding (64th byte)

    // ================================================================
    // Frame 1: Forward Slash "/" (64 bytes)
    // ================================================================
    // 2-pixel diagonal from bottom-left to top-right.
    // Pixel position at row r: columns shift from right to left.
    $00, $00, $06,       // Row 0
    $00, $00, $0C,       // Row 1
    $00, $00, $18,       // Row 2
    $00, $00, $30,       // Row 3
    $00, $00, $60,       // Row 4
    $00, $00, $C0,       // Row 5
    $00, $01, $80,       // Row 6
    $00, $03, $00,       // Row 7
    $00, $06, $00,       // Row 8
    $00, $0C, $00,       // Row 9
    $00, $18, $00,       // Row 10
    $00, $30, $00,       // Row 11
    $00, $60, $00,       // Row 12
    $00, $C0, $00,       // Row 13
    $01, $80, $00,       // Row 14
    $03, $00, $00,       // Row 15
    $06, $00, $00,       // Row 16
    $0C, $00, $00,       // Row 17
    $18, $00, $00,       // Row 18
    $30, $00, $00,       // Row 19
    $60, $00, $00,       // Row 20
    $00,                 // Padding (64th byte)

    // ================================================================
    // Frame 2: Horizontal Line "-" (64 bytes)
    // ================================================================
    // 3-pixel tall horizontal bar centered at rows 9-11.
    // Active rows: all 24 pixels on → $FF, $FF, $FF
    $00, $00, $00,       // Row 0
    $00, $00, $00,       // Row 1
    $00, $00, $00,       // Row 2
    $00, $00, $00,       // Row 3
    $00, $00, $00,       // Row 4
    $00, $00, $00,       // Row 5
    $00, $00, $00,       // Row 6
    $00, $00, $00,       // Row 7
    $00, $00, $00,       // Row 8
    $FF, $FF, $FF,       // Row 9
    $FF, $FF, $FF,       // Row 10
    $FF, $FF, $FF,       // Row 11
    $00, $00, $00,       // Row 12
    $00, $00, $00,       // Row 13
    $00, $00, $00,       // Row 14
    $00, $00, $00,       // Row 15
    $00, $00, $00,       // Row 16
    $00, $00, $00,       // Row 17
    $00, $00, $00,       // Row 18
    $00, $00, $00,       // Row 19
    $00, $00, $00,       // Row 20
    $00,                 // Padding (64th byte)

    // ================================================================
    // Frame 3: Backslash "\" (64 bytes)
    // ================================================================
    // 2-pixel diagonal from top-left to bottom-right.
    // Mirror of forward slash — pixels shift from left to right.
    $60, $00, $00,       // Row 0
    $30, $00, $00,       // Row 1
    $18, $00, $00,       // Row 2
    $0C, $00, $00,       // Row 3
    $06, $00, $00,       // Row 4
    $03, $00, $00,       // Row 5
    $01, $80, $00,       // Row 6
    $00, $C0, $00,       // Row 7
    $00, $60, $00,       // Row 8
    $00, $30, $00,       // Row 9
    $00, $18, $00,       // Row 10
    $00, $0C, $00,       // Row 11
    $00, $06, $00,       // Row 12
    $00, $03, $00,       // Row 13
    $00, $01, $80,       // Row 14
    $00, $00, $C0,       // Row 15
    $00, $00, $60,       // Row 16
    $00, $00, $30,       // Row 17
    $00, $00, $18,       // Row 18
    $00, $00, $0C,       // Row 19
    $00, $00, $06,       // Row 20
    $00                  // Padding (64th byte)
];

// ============================================================================
// getSpriteFrame() — Sprite Sheet Frame Selector
// ============================================================================
// Computes the VIC-II sprite pointer for a specific frame within a
// multi-frame @sprite sheet. This is the idiomatic way to select
// animation frames from contiguous sprite data.
//
// Math: pointer = (spriteAddr / 64) + frameIndex
//
// Since @sprite guarantees 64-byte alignment, spriteAddr is always
// divisible by 64. The division produces the base pointer, and adding
// frameIndex selects the specific frame.
//
// This function exercises two key bug fixes:
//   - Bug #1: @lineFrames is an address-of expression passed as word
//     (must NOT be promoted from byte — it's already a 16-bit address)
//   - Bug #2: spriteAddr / 64 is word division inside a function
//     (must use SHR_WORD, not 8-bit __div8)
//
// @param spriteAddr - 16-bit address of the sprite sheet (from @variable)
// @param frameIndex - Zero-based frame index (0 to numFrames-1)
// @return VIC-II sprite pointer value (byte)

function getSpriteFrame(spriteAddr: word, frameIndex: byte): byte {
    return lo(spriteAddr / 64) + frameIndex;
}

// ============================================================================
// Delay Function
// ============================================================================
// Busy-wait loop to control animation speed.
// Uses nested loops with barrier() to prevent the optimizer from
// removing the empty iterations.
//
// The inner loop uses 0 to 255 — the full byte range. This exercises
// Bug #3 fix: the compiler generates a post-body exit check instead
// of CMP #256 (which would overflow an 8-bit immediate).

function delay(): void {
    for (let _i: byte = 0 to 5) {
        for (let _j: byte = 0 to 255) {
            barrier();
        }
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

export function main(): void {
    // Step 1: Position sprite 0 at center of screen
    poke(VIC_SPRITE0_X, SPRITE_X);
    poke(VIC_SPRITE0_Y, SPRITE_Y);

    // Clear X MSB (bit 0) — X position 172 fits in 8 bits
    poke(VIC_SPRITE_X_MSB, 0);

    // Step 2: Set sprite 0 color to white
    poke(VIC_SPRITE0_COLOR, COLOR_WHITE);

    // Step 3: Enable sprite 0 (bit 0 of enable register)
    poke(VIC_SPRITE_ENABLE, 1);

    // Step 4: Set initial frame to vertical line (frame 0)
    // getSpriteFrame computes: lo(@lineFrames / 64) + 0
    poke(SPRITE0_POINTER, getSpriteFrame(@lineFrames, 0));

    // Step 5: Animation loop — cycle through | / - \ forever
    let frame: byte = 0;
    while (true) {
        // Select current animation frame from the sprite sheet.
        // getSpriteFrame(@lineFrames, frame) computes the VIC-II pointer:
        //   pointer = (base_address / 64) + frame
        // This is O(1) regardless of frame count — no if-else chain needed.
        poke(SPRITE0_POINTER, getSpriteFrame(@lineFrames, frame));
        delay();

        // Advance to next frame, wrapping at NUM_FRAMES
        frame = frame + 1;
        if (frame == NUM_FRAMES) {
            frame = 0;
        }
    }
}
