// ============================================================================
// plotChar() — Place a Character on Screen with Color
// ============================================================================
// NOTE: Uses repeated addition instead of multiplication because the
// compiler's __mul8 routine returns only 8 bits. For y >= 7 the product
// y * 40 exceeds 255, so the high byte would be lost. Repeated word
// addition avoids this overflow.

function plotChar(x: byte, y: byte, ch: byte, color: byte): void {
    let offset: word = 0;
    let row: byte = y;
    while (row > 0) {
        offset = offset + SCREEN_WIDTH;
        row = row - 1;
    }
    offset = offset + x;
    poke(SCREEN_BASE + offset, ch);
    poke(COLOR_BASE + offset, color);
}

// ============================================================================
// clearScreen() — Fill Screen with Spaces
// ============================================================================

function clearScreen(): void {
    for (let i: word = 0 to 999) {
        poke(SCREEN_BASE + i, CHAR_SPACE);
        poke(COLOR_BASE + i, COLOR_WHITE);
    }
}

// ============================================================================
// copyCharset() — Copy Font Data to VIC-Safe Address
// ============================================================================
// The @charset alignment may place font data at $1000, which falls in the
// C64 character ROM shadow ($1000-$1FFF). The VIC-II reads built-in ROM
// there instead of RAM. The CPU can still read our data from RAM at $1000,
// so we copy it to $2000 where the VIC-II can see it.
// This is a standard C64 technique for custom character sets.

function copyCharset(): void {
    for (let i: word = 0 to 2047) {
        poke(CHARSET_DEST + i, peek(@armenianFont + i));
    }
}

// ============================================================================
// delay() — Visible Animation Pause
// ============================================================================

function delay(): void {
    for (let _outer: byte = 0 to 30) {
        for (let _inner: byte = 0 to 255) {
            barrier();
        }
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

export function main(): void {
    // Step 1: Set Armenian flag colors (blue border, black background)
    poke(BORDER_COLOR, COLOR_BLUE);
    poke(BACKGROUND_COLOR, COLOR_BLACK);

    // Step 2: Clear screen with custom space character
    clearScreen();

    // Step 3: Copy charset to VIC-safe address and switch VIC-II
    // The @charset data lands at $1000 (C64 character ROM shadow area).
    // The VIC-II reads ROM there instead of RAM, so we copy our font data
    // to $2000 where the VIC-II can see it. The CPU reads RAM at $1000
    // just fine, so the copy works correctly.
    copyCharset();

    // Point VIC-II to our charset copy at $2000
    // $D018 bits 4-7 = screen address, bits 1-3 = charset address
    // charset bits = (address / 2048) << 1 = ($2000 / 2048) << 1 = 4 << 1 = $08
    let screenBits: byte = peek(VIC_MEMORY_SETUP) & $F0;
    poke(VIC_MEMORY_SETUP, screenBits | $08);

    // Step 4: Display "Barev Ashkharh" centered on row 3
    for (let i: byte = 0 to HELLO_LENGTH - 1) {
        plotChar(14 + i, 3, helloWorld[i], COLOR_RED);
    }

    // Step 5: Snake animation — alphabet crawls in serpentine pattern
    // Colors by row: Red, Blue, Orange, Red (Armenian flag stripes)
    for (let letterIndex: byte = 0 to ALPHABET_LENGTH - 1) {
        let color: byte = COLOR_RED;
        if (snakeY[letterIndex] == 11) {
            color = COLOR_BLUE;
        }
        if (snakeY[letterIndex] == 12) {
            color = COLOR_ORANGE;
        }

        plotChar(snakeX[letterIndex], snakeY[letterIndex], letterIndex, color);
        delay();
    }

    // Step 6: Hold display forever
    while (true) {
        barrier();
    }
}
