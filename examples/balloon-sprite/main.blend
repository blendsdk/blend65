// ============================================================================
// Balloon Sprite Example
// ============================================================================
// Displays a balloon-shaped sprite in the center of the C64 screen.
//
// This example demonstrates:
//   - @sprite for 64-byte aligned sprite data in the data segment
//   - @ address-of operator to get the runtime address of sprite data
//   - hi() intrinsic to extract the high byte of a word
//   - VIC-II sprite setup (pointer, position, color, enable)
//   - No manual memory copying needed — VIC-II reads directly from @sprite data
//
// C64 Sprite Facts:
//   - Each sprite is 24×21 pixels (3 bytes/row × 21 rows = 63 bytes)
//   - Sprite data must live at a 64-byte aligned address
//   - The VIC-II reads sprite pointers from screen RAM + $03F8
//   - Pointer value = sprite_data_address / 64
//
// With @sprite, the compiler aligns the data automatically in the
// data segment. The @ operator lets us compute the sprite pointer
// at runtime: hi(@data) * 4  (equivalent to address / 64 for
// 64-byte aligned addresses where the low 6 bits are always zero).
//
// Module: BalloonSprite
// Target: Commodore 64
// ============================================================================

module BalloonSprite;

// ============================================================================
// VIC-II Registers
// ============================================================================

const VIC_SPRITE0_X: word = $D000;       // Sprite 0 X position (low 8 bits)
const VIC_SPRITE0_Y: word = $D001;       // Sprite 0 Y position
const VIC_SPRITE_X_MSB: word = $D010;    // X position MSB for all sprites
const VIC_SPRITE_ENABLE: word = $D015;   // Sprite enable register (1 bit per sprite)
const VIC_SPRITE0_COLOR: word = $D027;   // Sprite 0 individual color

// Sprite 0 pointer: default screen ($0400) + $03F8 + sprite number
const SPRITE0_POINTER: word = $07F8;

// ============================================================================
// Screen Position (center of visible area)
// ============================================================================
// VIC-II visible area starts at X=24, Y=50 and is 320×200 pixels.
// Screen center = (24 + 160, 50 + 100) = (184, 150)
// Sprite center offset: 12px wide, 10px tall (half of 24×21)
// Centered sprite position: X = 184 - 12 = 172, Y = 150 - 10 = 140

const SPRITE_X: byte = 172;
const SPRITE_Y: byte = 140;

// ============================================================================
// C64 Colors
// ============================================================================

const COLOR_RED: byte = 3;

// ============================================================================
// Balloon Sprite Data (24×21 pixels = 63 bytes)
// ============================================================================
// @sprite ensures 64-byte alignment in the data segment.
// The VIC-II reads sprite graphics directly from this address —
// no manual copy to a fixed location is needed.
//
// Each row is 3 bytes (24 pixels). Pixel layout:
//
// Row  0: ........XXXX........   $00 $3C $00
// Row  1: ......XXXXXXXX......   $00 $FF $00
// Row  2: .....XXXXXXXXXX.....   $01 $FF $80
// Row  3: ....XXXXXXXXXXXX....   $03 $FF $C0
// Row  4: ...XXXXXXXXXXXXXX...   $07 $FF $E0
// Row  5: ...XXXXXXXXXXXXXX...   $07 $FF $E0
// Row  6: ..XXXXXXXXXXXXXXXX..   $0F $FF $F0
// Row  7: ..XXXXXXXXXXXXXXXX..   $0F $FF $F0
// Row  8: ..XXXXXXXXXXXXXXXX..   $0F $FF $F0
// Row  9: ..XXXXXXXXXXXXXXXX..   $0F $FF $F0
// Row 10: ...XXXXXXXXXXXXXX...   $07 $FF $E0
// Row 11: ...XXXXXXXXXXXXXX...   $07 $FF $E0
// Row 12: ....XXXXXXXXXXXX....   $03 $FF $C0
// Row 13: .....XXXXXXXXXX.....   $01 $FF $80
// Row 14: ......XXXXXXXX......   $00 $FF $00
// Row 15: ........XXXX........   $00 $3C $00
// Row 16: .........XX.........   $00 $18 $00  (knot)
// Row 17: .........XX.........   $00 $18 $00
// Row 18: ........XXXX........   $00 $3C $00  (string bow)
// Row 19: ........XXXX........   $00 $3C $00
// Row 20: .........XX.........   $00 $18 $00  (string end)

@sprite const balloonData: byte[] = [
    $00, $3C, $00,
    $00, $FF, $00,
    $01, $FF, $80,
    $03, $FF, $C0,
    $07, $FF, $E0,
    $07, $FF, $E0,
    $0F, $FF, $F0,
    $0F, $FF, $F0,
    $0F, $FF, $F0,
    $0F, $FF, $F0,
    $07, $FF, $E0,
    $07, $FF, $E0,
    $03, $FF, $C0,
    $01, $FF, $80,
    $00, $FF, $00,
    $00, $3C, $00,
    $00, $18, $00,
    $00, $18, $00,
    $00, $3C, $00,
    $00, $3C, $00,
    $00, $18, $00
];

// ============================================================================
// Main Entry Point
// ============================================================================

export function main(): void {
    // Step 1: Compute sprite pointer from @sprite data address.
    //
    // The VIC-II sprite pointer = data_address / 64.
    // Since @sprite guarantees 64-byte alignment, the low 6 bits
    // of the address are always zero. This means:
    //   address / 64  =  hi(address) * 4
    //
    // The @ operator loads the 16-bit address into A:X (lo:hi),
    // and hi() extracts the high byte (X register).
    let spritePtr: byte = hi(@balloonData) * 4;
    poke(SPRITE0_POINTER, spritePtr);

    // Step 2: Position sprite 0 at center of screen
    poke(VIC_SPRITE0_X, SPRITE_X);
    poke(VIC_SPRITE0_Y, SPRITE_Y);

    // Clear X MSB (bit 0) — X position 172 fits in 8 bits
    poke(VIC_SPRITE_X_MSB, 0);

    // Step 3: Set sprite 0 color to red
    poke(VIC_SPRITE0_COLOR, COLOR_RED);

    // Step 4: Enable sprite 0 (bit 0 of enable register)
    poke(VIC_SPRITE_ENABLE, 1);
}
