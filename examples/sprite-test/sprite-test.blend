// Pilot Program 006: Screen Fill
// Fill screen and color RAM using constant addresses and helper functions.
// Exercises: nested for-loops, function calls, poke with constants.

module Pilot.ScreenFill;

export function main(): void {
    // Set border and background colors
    poke($D020, 6);
    poke($D021, 14);

    // Write characters to specific constant screen positions
    // First row
    poke($0400, 160);
    poke($0401, 160);
    poke($0402, 160);
    poke($0403, 160);
    poke($0404, 160);

    // Set colors on first row
    poke($D800, 14);
    poke($D801, 14);
    poke($D802, 14);
    poke($D803, 14);
    poke($D804, 14);

    // Second row (offset +40)a
    poke($0428, 160);
    poke($0429, 160);
    poke($042A, 160);
    poke($042B, 160);
    poke($042C, 160);

    // Colors second row
    poke($D828, 1);
    poke($D829, 1);
    poke($D82A, 1);
    poke($D82B, 1);
    poke($D82C, 1);
}
