module Test.ByteArithmetic;

// =============================================================================
// Test: Byte Arithmetic Operations
// =============================================================================
// Exercises all basic byte (8-bit unsigned) arithmetic:
//   Test 1: Addition (10 + 20 = 30)
//   Test 2: Subtraction (50 - 20 = 30)
//   Test 3: Multiplication (6 * 7 = 42)
//   Test 4: Overflow wrapping (250 + 10 = 4, wraps at 256)
//   Test 5: Division (100 / 5 = 20)
//   Test 6: Modulo (17 % 5 = 2)
//   Test 7: Left shift (3 << 2 = 12)
//   Test 8: Right shift (128 >> 3 = 16)
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Addition — 10 + 20 = 30
    // -------------------------------------------------------------------------
    let a: byte = 10;
    let b: byte = 20;
    let result: byte = a + b;
    if (result == 30) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Subtraction — 50 - 20 = 30
    // -------------------------------------------------------------------------
    a = 50;
    b = 20;
    result = a - b;
    if (result == 30) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Multiplication — 6 * 7 = 42
    // -------------------------------------------------------------------------
    a = 6;
    b = 7;
    result = a * b;
    if (result == 42) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Overflow wrapping — 250 + 10 = 4 (byte wraps at 256)
    // -------------------------------------------------------------------------
    a = 250;
    b = 10;
    result = a + b;
    if (result == 4) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Division — 100 / 5 = 20
    // -------------------------------------------------------------------------
    a = 100;
    b = 5;
    result = a / b;
    if (result == 20) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Modulo — 17 % 5 = 2
    // -------------------------------------------------------------------------
    a = 17;
    b = 5;
    result = a % b;
    if (result == 2) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 7: Left shift — 3 << 2 = 12
    // -------------------------------------------------------------------------
    a = 3;
    result = a << 2;
    if (result == 12) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 8: Right shift — 128 >> 3 = 16
    // -------------------------------------------------------------------------
    a = 128;
    result = a >> 3;
    if (result == 16) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
