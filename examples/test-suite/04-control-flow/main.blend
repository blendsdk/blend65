module Test.ControlFlow;

// =============================================================================
// Test: Control Flow Structures
// =============================================================================
// Exercises control flow constructs:
//   Test 1: if-else — true branch taken
//   Test 2: if-else — false/else branch taken
//   Test 3: if-else if-else chain — middle branch
//   Test 4: while loop — counts to 10
//   Test 5: nested while loops — 3 * 4 = 12 iterations
//   Test 6: while loop with flag — loop runs 3 times then flag stops it
//   Test 7: while loop sum — sums 1 to 5 = 15
//   Test 8: while loop countdown — 5 down to 1, sum = 15
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: if-else — true branch taken (10 > 5 is true)
    // -------------------------------------------------------------------------
    let result: byte = 0;
    let a: byte = 10;
    if (a > 5) {
        result = 1;
    } else {
        result = 0;
    }
    if (result == 1) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: if-else — false/else branch taken (3 > 5 is false)
    // -------------------------------------------------------------------------
    result = 0;
    a = 3;
    if (a > 5) {
        result = 99;
    } else {
        result = 42;
    }
    if (result == 42) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: if-else if-else chain — middle branch (a == 2)
    // -------------------------------------------------------------------------
    result = 0;
    a = 2;
    if (a == 1) {
        result = 10;
    } else if (a == 2) {
        result = 20;
    } else if (a == 3) {
        result = 30;
    } else {
        result = 99;
    }
    if (result == 20) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: while loop — counts to 10
    // -------------------------------------------------------------------------
    let counter: byte = 0;
    while (counter < 10) {
        counter = counter + 1;
    }
    if (counter == 10) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: nested while loops — 3 outer * 4 inner = 12 iterations
    // -------------------------------------------------------------------------
    counter = 0;
    let outer: byte = 0;
    while (outer < 3) {
        let inner: byte = 0;
        while (inner < 4) {
            counter = counter + 1;
            inner = inner + 1;
        }
        outer = outer + 1;
    }
    if (counter == 12) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: while loop with flag — loop runs 3 times then flag stops it
    // -------------------------------------------------------------------------
    counter = 0;
    let running: byte = 1;
    while (running == 1) {
        counter = counter + 1;
        if (counter == 3) {
            running = 0;
        }
    }
    if (counter == 3) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 7: while loop sum — sums 1 to 5 = 15
    // -------------------------------------------------------------------------
    let sum: byte = 0;
    let i: byte = 1;
    while (i < 6) {
        sum = sum + i;
        i = i + 1;
    }
    if (sum == 15) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 8: while loop countdown — 5 down to 1, sum = 15
    // -------------------------------------------------------------------------
    sum = 0;
    let j: byte = 5;
    while (j > 0) {
        sum = sum + j;
        j = j - 1;
    }
    if (sum == 15) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
