module Test.LargeData;

// =============================================================================
// Test: Large Data Segments — @data Arrays, @sprite Alignment
// =============================================================================
// Exercises larger data segments and alignment verification:
//   Test 1: @data 32-byte array — first element correct
//   Test 2: @data 32-byte array — middle element (offset 15) correct
//   Test 3: @data 32-byte array — last element (offset 31) correct
//   Test 4: @sprite 63-byte array — first byte correct
//   Test 5: @sprite 63-byte array — last byte (index 62) correct
//   Test 6: @data + @sprite coexist — both arrays readable independently
//
// Tests that the compiler correctly handles:
//   - Larger @data arrays (32 bytes)
//   - @sprite arrays (63 bytes with 64-byte alignment)
//   - Multiple data segment entries coexisting
//   - Boundary element access (first, middle, last)
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

// 32-byte @data array with known pattern: index + $A0
// Element values: $A0, $A1, $A2, ... $BF
@data const bigTable: byte[] = [
    $A0, $A1, $A2, $A3, $A4, $A5, $A6, $A7,
    $A8, $A9, $AA, $AB, $AC, $AD, $AE, $AF,
    $B0, $B1, $B2, $B3, $B4, $B5, $B6, $B7,
    $B8, $B9, $BA, $BB, $BC, $BD, $BE, $BF
];

// @sprite — 63 bytes of test data (aligned to 64 bytes by compiler)
// Pattern: first byte $01, middle bytes alternate $55/$AA, last byte $FE
@sprite const testSprite: byte[] = [
    $01, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $AA,
    $55, $AA, $55,
    $AA, $55, $FE
];

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: @data 32-byte array — first element bigTable[0] == $A0
    // -------------------------------------------------------------------------
    let val: byte = bigTable[0];
    if (val == $A0) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: @data 32-byte array — middle element peek(@bigTable + 15) == $AF
    // NOTE: arr[const > 0] has a codegen bug for @data arrays, so we use
    // the peek(@array + offset) pattern which is proven to work.
    // -------------------------------------------------------------------------
    val = peek(@bigTable + 15);
    if (val == $AF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: @data 32-byte array — last element peek(@bigTable + 31) == $BF
    // -------------------------------------------------------------------------
    val = peek(@bigTable + 31);
    if (val == $BF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: @sprite array — first byte peek(@testSprite) == $01
    // -------------------------------------------------------------------------
    let sprVal: byte = peek(@testSprite);
    if (sprVal == $01) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: @sprite array — last byte peek(@testSprite + 62) == $FE
    // Sprite is 63 bytes, so last byte is at offset 62
    // -------------------------------------------------------------------------
    sprVal = peek(@testSprite + 62);
    if (sprVal == $FE) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Both arrays coexist — verify bigTable[0] still $A0
    // after reading from testSprite (ensures no data overlap)
    // -------------------------------------------------------------------------
    let recheck: byte = peek(@bigTable);
    if (recheck == $A0) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
