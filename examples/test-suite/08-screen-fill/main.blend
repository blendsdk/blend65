module Test.ScreenFill;

// =============================================================================
// Test: Screen Memory Fill Patterns
// =============================================================================
// Exercises writing to screen RAM ($0400-$07E7, 1000 bytes):
//   Test 1: Write single char to screen, read back
//   Test 2: Write to 3 consecutive positions, verify all
//   Test 3: Fill 10 bytes with loop, verify first and last
//   Test 4: Write to last row start ($07C0), verify
//   Test 5: Write to last screen position ($07E7), verify
//   Test 6: Verify earlier writes still intact (no cross-contamination)
//
// Uses screen row 3+ ($0478) for test writes to avoid result area (row 0).
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

// Test area: row 3 of screen ($0400 + 120 = $0478)
// Far enough from result bytes at $0400-$040F
const TEST_AREA: word = $0478;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Write single char to screen, read back
    // -------------------------------------------------------------------------
    poke(TEST_AREA, $41);
    let readBack: byte = peek(TEST_AREA);
    if (readBack == $41) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Write to 3 consecutive positions, verify all
    // -------------------------------------------------------------------------
    poke(TEST_AREA + 1, $42);
    poke(TEST_AREA + 2, $43);
    poke(TEST_AREA + 3, $44);
    let v1: byte = peek(TEST_AREA + 1);
    let v2: byte = peek(TEST_AREA + 2);
    let v3: byte = peek(TEST_AREA + 3);
    if (v1 == $42) {
        if (v2 == $43) {
            if (v3 == $44) {
                poke(SCREEN + 2 + testNum, 1);
                passed = passed + 1;
            } else {
                poke(SCREEN + 2 + testNum, 0);
            }
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Fill 10 bytes with loop, verify first and last
    // Writes values 1..10 to TEST_AREA+10 through TEST_AREA+19
    // -------------------------------------------------------------------------
    let i: byte = 0;
    while (i < 10) {
        poke(TEST_AREA + 10 + i, i + 1);
        i = i + 1;
    }
    let first: byte = peek(TEST_AREA + 10);
    let last: byte = peek(TEST_AREA + 19);
    if (first == 1) {
        if (last == 10) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Write to last row start ($07C0), verify
    // Last row = row 24 = $0400 + 960 = $07C0
    // -------------------------------------------------------------------------
    poke($07C0, $55);
    readBack = peek($07C0);
    if (readBack == $55) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Write to last screen position ($07E7), verify
    // $07E7 = $0400 + 999 (last visible character)
    // -------------------------------------------------------------------------
    poke($07E7, $AA);
    readBack = peek($07E7);
    if (readBack == $AA) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Verify earlier writes still intact (no cross-contamination)
    // Check that Test 1 and Test 2 values are still present
    // -------------------------------------------------------------------------
    let check1: byte = peek(TEST_AREA);
    let check2: byte = peek(TEST_AREA + 1);
    if (check1 == $41) {
        if (check2 == $42) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
