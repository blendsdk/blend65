module Test.FullPipeline;

// =============================================================================
// Test: Full Pipeline Integration — Everything Together
// =============================================================================
// Comprehensive test combining ALL major language features:
//   Test 1: Function + loop — helper fills memory, verify pattern
//   Test 2: @data array + function — read from data, transform, store
//   Test 3: Nested control flow + globals — state machine simulation
//   Test 4: Word arithmetic + lo/hi + poke — address computation chain
//   Test 5: Multi-function chain + loop + memory — complete workflow
//   Test 6: Conditional dispatch + global state + verification
//
// This test exercises the COMPLETE compiler pipeline:
//   Lexer → Parser → Semantic → IL → Optimizer → Codegen → Assembler
// If all 6 tests pass, the entire compilation toolchain is working for
// these patterns.
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Scratch memory: $C010-$C04F (free RAM, avoids sentinel at $C000)
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;
const SCRATCH: word = $C010;

// Global state for state machine test
let machineState: byte = 0;
let machineOutput: byte = 0;

// @data array for lookup table test (using peek(@arr+N) to avoid Bug D1)
@data const lookupTable: byte[] = [
    10, 20, 30, 40, 50, 60, 70, 80
];

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

// Fills count bytes starting at addr with value val
function fillMemory(addr: word, val: byte, count: byte): void {
    let i: byte = 0;
    while (i < count) {
        poke(addr + i, val);
        i = i + 1;
    }
}

// Returns the sum of a byte range in memory (addr to addr+count-1)
function sumMemory(addr: word, count: byte): byte {
    let sum: byte = 0;
    let i: byte = 0;
    while (i < count) {
        sum = sum + peek(addr + i);
        i = i + 1;
    }
    return sum;
}

// Transforms input: doubles it and adds 1
function transform(x: byte): byte {
    return x + x + 1;
}

// State machine step: advances machineState and sets machineOutput
// State 0 → output 10, advance to state 1
// State 1 → output 20, advance to state 2
// State 2 → output 30, advance to state 3 (terminal)
function stepMachine(): void {
    if (machineState == 0) {
        machineOutput = 10;
        machineState = 1;
    } else if (machineState == 1) {
        machineOutput = 20;
        machineState = 2;
    } else if (machineState == 2) {
        machineOutput = 30;
        machineState = 3;
    }
}

// Clamps a byte to range [minVal, maxVal]
function clamp(val: byte, minVal: byte, maxVal: byte): byte {
    if (val < minVal) {
        return minVal;
    }
    if (val > maxVal) {
        return maxVal;
    }
    return val;
}

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Function + loop — fillMemory writes $AA to 8 bytes, verify sum
    // fillMemory(SCRATCH, $AA, 8) → 8 bytes of $AA
    // Each byte = $AA = 170. Sum of 8 × 170 would overflow byte (1360).
    // Instead verify individual bytes are correct.
    // -------------------------------------------------------------------------
    fillMemory(SCRATCH, $AA, 8);
    let ok: byte = 1;
    if (peek(SCRATCH) != $AA) { ok = 0; }
    if (peek(SCRATCH + 3) != $AA) { ok = 0; }
    if (peek(SCRATCH + 7) != $AA) { ok = 0; }
    if (ok == 1) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: @data array + function — read from lookup, transform, store
    // Read lookupTable[0]=10 via peek, transform(10) = 21, store to scratch
    // Read lookupTable[3]=40 via peek(@lookupTable+3), transform(40)=81
    // Verify both transformed values
    // -------------------------------------------------------------------------
    let val0: byte = peek(@lookupTable);
    let transformed0: byte = transform(val0);
    poke(SCRATCH + 16, transformed0);

    let val3: byte = peek(@lookupTable + 3);
    let transformed3: byte = transform(val3);
    poke(SCRATCH + 17, transformed3);

    // transform(10) = 10+10+1 = 21
    // transform(40) = 40+40+1 = 81
    if (peek(SCRATCH + 16) == 21) {
        if (peek(SCRATCH + 17) == 81) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: State machine — step 3 times, verify final state and output
    // State 0 → 1 (output 10) → 2 (output 20) → 3 (output 30)
    // After 3 steps: machineState=3, machineOutput=30
    // -------------------------------------------------------------------------
    machineState = 0;
    machineOutput = 0;
    stepMachine();
    stepMachine();
    stepMachine();
    if (machineState == 3) {
        if (machineOutput == 30) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Word arithmetic + lo/hi + poke — compute sum, extract bytes
    // Compute $0300 + $0456 = $0756
    // lo($0756) = $56, hi($0756) = $07
    // Store both to scratch and verify
    // -------------------------------------------------------------------------
    let baseAddr: word = $0300;
    let offset: word = $0456;
    let computed: word = baseAddr + offset;
    let cLo: byte = lo(computed);
    let cHi: byte = hi(computed);
    poke(SCRATCH + 24, cLo);
    poke(SCRATCH + 25, cHi);
    if (peek(SCRATCH + 24) == $56) {
        if (peek(SCRATCH + 25) == $07) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Multi-function + loop + memory — fill, sum, verify
    // Fill SCRATCH+32..35 with values 1,2,3,4 via loop
    // Then use sumMemory() to add them up: 1+2+3+4 = 10
    // -------------------------------------------------------------------------
    let i: byte = 0;
    while (i < 4) {
        poke(SCRATCH + 32 + i, i + 1);
        i = i + 1;
    }
    let total: byte = sumMemory(SCRATCH + 32, 4);
    if (total == 10) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Clamp function + conditional — verify boundary behavior
    // clamp(5, 10, 200) = 10 (below min)
    // clamp(150, 10, 200) = 150 (in range)
    // clamp(250, 10, 200) = 200 (above max)
    // Sum of results: 10 + 150 + 200 = 360 → overflows to 360-256 = 104
    // Store individual results to verify without overflow issues
    // -------------------------------------------------------------------------
    let c1: byte = clamp(5, 10, 200);
    let c2: byte = clamp(150, 10, 200);
    let c3: byte = clamp(250, 10, 200);
    // c1=10, c2=150, c3=200
    ok = 1;
    if (c1 != 10) { ok = 0; }
    if (c2 != 150) { ok = 0; }
    if (c3 != 200) { ok = 0; }
    if (ok == 1) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
