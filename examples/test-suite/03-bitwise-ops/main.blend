module Test.BitwiseOps;

// =============================================================================
// Test: Bitwise Operations
// =============================================================================
// Exercises all bitwise operators on byte values:
//   Test 1: AND — $F0 & $0F = $00
//   Test 2: OR  — $AA | $55 = $FF
//   Test 3: XOR — $FF ^ $AA = $55
//   Test 4: NOT — ~$0F = $F0
//   Test 5: Left shift — $01 << 4 = $10
//   Test 6: Right shift — $80 >> 4 = $08
//   Test 7: Combined AND+OR — ($F0 & $FF) | $0F = $FF
//   Test 8: AND masking — 255 & $0F = 15
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: AND — $F0 & $0F = $00
    // All bits cancel: 11110000 & 00001111 = 00000000
    // -------------------------------------------------------------------------
    let a: byte = $F0;
    let b: byte = $0F;
    let result: byte = a & b;
    if (result == $00) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: OR — $AA | $55 = $FF
    // Alternating bits combine: 10101010 | 01010101 = 11111111
    // -------------------------------------------------------------------------
    a = $AA;
    b = $55;
    result = a | b;
    if (result == $FF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: XOR — $FF ^ $AA = $55
    // 11111111 ^ 10101010 = 01010101
    // -------------------------------------------------------------------------
    a = $FF;
    b = $AA;
    result = a ^ b;
    if (result == $55) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: NOT — ~$0F = $F0
    // ~00001111 = 11110000
    // -------------------------------------------------------------------------
    a = $0F;
    result = ~a;
    if (result == $F0) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Left shift — $01 << 4 = $10
    // 00000001 << 4 = 00010000
    // -------------------------------------------------------------------------
    a = $01;
    result = a << 4;
    if (result == $10) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Right shift — $80 >> 4 = $08
    // 10000000 >> 4 = 00001000
    // -------------------------------------------------------------------------
    a = $80;
    result = a >> 4;
    if (result == $08) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 7: Combined AND + OR — ($F0 & $FF) | $0F = $FF
    // ($F0 & $FF) = $F0, then $F0 | $0F = $FF
    // -------------------------------------------------------------------------
    a = $F0;
    result = (a & $FF) | $0F;
    if (result == $FF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 8: AND masking — 255 & $0F = 15 ($0F)
    // Common C64 pattern: masking to lower nibble
    // -------------------------------------------------------------------------
    a = 255;
    result = a & $0F;
    if (result == 15) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
