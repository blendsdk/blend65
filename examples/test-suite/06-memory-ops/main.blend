module Test.MemoryOps;

// =============================================================================
// Test: Memory Operations (poke, peek, lo, hi)
// =============================================================================
// Exercises memory access intrinsics and byte extraction:
//   Test 1: poke + peek roundtrip — write and read back a byte
//   Test 2: poke to consecutive addresses — sequential writes
//   Test 3: peek reads correct value from known location
//   Test 4: lo() extracts low byte of word constant
//   Test 5: hi() extracts high byte of word constant
//   Test 6: lo/hi of word variable
//   Test 7: pokew + peekw roundtrip — write and read 16-bit word
//   Test 8: poke computed address — SCREEN + offset
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Memory used for testing: $C000-$C010 (free RAM on C64)
// Completion sentinel: poke($C000, $42) — written LAST, after tests use $C010+
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;
// Use $C010+ for test scratch space (avoid sentinel address)
const SCRATCH: word = $C010;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: poke + peek roundtrip — write $AB, read it back
    // -------------------------------------------------------------------------
    poke(SCRATCH, $AB);
    let readBack: byte = peek(SCRATCH);
    if (readBack == $AB) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: poke to consecutive addresses — write 3 values, verify all
    // -------------------------------------------------------------------------
    poke(SCRATCH + 1, 10);
    poke(SCRATCH + 2, 20);
    poke(SCRATCH + 3, 30);
    let v1: byte = peek(SCRATCH + 1);
    let v2: byte = peek(SCRATCH + 2);
    let v3: byte = peek(SCRATCH + 3);
    if (v1 == 10) {
        if (v2 == 20) {
            if (v3 == 30) {
                poke(SCREEN + 2 + testNum, 1);
                passed = passed + 1;
            } else {
                poke(SCREEN + 2 + testNum, 0);
            }
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: peek reads correct value — write known value, verify
    // -------------------------------------------------------------------------
    poke(SCRATCH + 4, $FF);
    let peekVal: byte = peek(SCRATCH + 4);
    if (peekVal == $FF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: lo() extracts low byte — lo($1234) = $34
    // -------------------------------------------------------------------------
    let addr: word = $1234;
    let lowByte: byte = lo(addr);
    if (lowByte == $34) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: hi() extracts high byte — hi($1234) = $12
    // -------------------------------------------------------------------------
    let highByte: byte = hi(addr);
    if (highByte == $12) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: lo/hi of word variable — $ABCD => lo=$CD, hi=$AB
    // -------------------------------------------------------------------------
    let testWord: word = $ABCD;
    let tLo: byte = lo(testWord);
    let tHi: byte = hi(testWord);
    if (tLo == $CD) {
        if (tHi == $AB) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 7: pokew + peekw roundtrip — write $BEEF, read back
    // -------------------------------------------------------------------------
    pokew(SCRATCH + 5, $BEEF);
    let wordBack: word = peekw(SCRATCH + 5);
    if (wordBack == $BEEF) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 8: poke to computed address — write to SCREEN + variable offset
    // -------------------------------------------------------------------------
    let offset: byte = 100;
    poke(SCREEN + offset, $55);
    let check: byte = peek(SCREEN + offset);
    if (check == $55) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
