module Test.FunctionCalls;

// =============================================================================
// Test: Function Calls and Return Values
// =============================================================================
// Exercises function declaration, parameters, and return values:
//   Test 1: Function with no params returns constant
//   Test 2: Function with one byte param, returns byte
//   Test 3: Function with two params, returns sum
//   Test 4: Function returning word type
//   Test 5: Void function modifies global variable
//   Test 6: Nested function calls (f(g(x)))
//   Test 7: Function with early return (if guard)
//   Test 8: Multiple function calls in expression
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

// Global variable for Test 5 (void function side-effect)
let globalVal: byte = 0;

// ---------------------------------------------------------------------------
// Helper functions used by the tests
// ---------------------------------------------------------------------------

// Returns a constant value (42)
function getFortyTwo(): byte {
    return 42;
}

// Returns the byte parameter doubled
function doubleByte(x: byte): byte {
    return x + x;
}

// Returns the sum of two byte parameters
function addBytes(a: byte, b: byte): byte {
    return a + b;
}

// Returns a word constant
function getWordConst(): word {
    return 1000;
}

// Void function that modifies a global variable
function setGlobal(val: byte): void {
    globalVal = val;
}

// Returns input + 1 (used for nesting)
function increment(x: byte): byte {
    return x + 1;
}

// Returns 0 if input is 0, otherwise returns 1 (early return guard)
function safeNonZero(x: byte): byte {
    if (x == 0) {
        return 0;
    }
    return 1;
}

// Returns min of two bytes
function minByte(a: byte, b: byte): byte {
    if (a < b) {
        return a;
    }
    return b;
}

// Returns max of two bytes
function maxByte(a: byte, b: byte): byte {
    if (a > b) {
        return a;
    }
    return b;
}

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Function with no params returns constant (42)
    // -------------------------------------------------------------------------
    let result: byte = getFortyTwo();
    if (result == 42) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Function with one param — doubleByte(15) = 30
    // -------------------------------------------------------------------------
    result = doubleByte(15);
    if (result == 30) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Function with two params — addBytes(25, 17) = 42
    // -------------------------------------------------------------------------
    result = addBytes(25, 17);
    if (result == 42) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Function returning word — getWordConst() = 1000
    // -------------------------------------------------------------------------
    let wResult: word = getWordConst();
    if (wResult == 1000) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Void function modifies global — setGlobal(99)
    // -------------------------------------------------------------------------
    globalVal = 0;
    setGlobal(99);
    if (globalVal == 99) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Nested calls — increment(increment(increment(0))) = 3
    // -------------------------------------------------------------------------
    result = increment(increment(increment(0)));
    if (result == 3) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 7: Early return guard — safeNonZero(0)=0, safeNonZero(5)=1
    // -------------------------------------------------------------------------
    let r1: byte = safeNonZero(0);
    let r2: byte = safeNonZero(5);
    if (r1 == 0) {
        if (r2 == 1) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 8: Multiple calls in expression — minByte(10,20) + maxByte(10,20) = 30
    // -------------------------------------------------------------------------
    result = minByte(10, 20) + maxByte(10, 20);
    if (result == 30) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
