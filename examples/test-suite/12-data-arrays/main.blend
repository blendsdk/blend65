module Test.DataArrays;

// =============================================================================
// Test: @data Arrays — Byte Arrays, Indexing, peek(@array + offset)
// =============================================================================
// Exercises @data const arrays with various access patterns:
//   Test 1: @data byte array — array indexing with constant (arr[0])
//   Test 2: @data byte array — peek at offset 4 (workaround: arr[const>0] codegen bug)
//   Test 3: @data byte array — array indexing with variable
//   Test 4: @data byte array — peek(@array) reads first byte
//   Test 5: @data byte array — peek(@array + N) reads Nth byte
//   Test 6: Second @data array — independent arrays don't overlap
//
// @data arrays are const (read-only), allocated in the data segment.
// They can be accessed via:
//   - Array indexing:  arr[index]
//   - Address peek:    peek(@arr + offset)
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;

// First @data array — 8 known byte values
@data const tableA: byte[] = [$10, $20, $30, $40, $50, $60, $70, $80];

// Second @data array — different values to verify independence
@data const tableB: byte[] = [$AA, $BB, $CC, $DD, $EE];

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Array indexing with constant index — tableA[0] == $10
    // -------------------------------------------------------------------------
    let val: byte = tableA[0];
    if (val == $10) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Read element at offset 4 via peek — peek(@tableA + 4) == $50
    // NOTE: arr[const > 0] has a codegen bug for @data arrays, so we use
    // the peek(@array + offset) pattern which is proven to work.
    // -------------------------------------------------------------------------
    val = peek(@tableA + 4);
    if (val == $50) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Array indexing with variable index — tableA[idx] == $70
    // -------------------------------------------------------------------------
    let idx: byte = 6;
    val = tableA[idx];
    if (val == $70) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: peek(@tableA) reads first byte — $10
    // Address-of operator returns the word address of the array
    // -------------------------------------------------------------------------
    let peekVal: byte = peek(@tableA);
    if (peekVal == $10) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: peek(@tableA + 7) reads last byte — $80
    // -------------------------------------------------------------------------
    peekVal = peek(@tableA + 7);
    if (peekVal == $80) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Second @data array — tableB[0] == $AA (independent from tableA)
    // Verifies multiple @data arrays coexist without overlap
    // -------------------------------------------------------------------------
    let bVal: byte = tableB[0];
    if (bVal == $AA) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
