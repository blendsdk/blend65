module Test.ColorRam;

// =============================================================================
// Test: Color RAM Operations
// =============================================================================
// Exercises Color RAM ($D800-$DBE7, 1000 nibbles):
//   Test 1: Write single color, read back (masked to low nibble)
//   Test 2: Write 3 different colors to adjacent positions, verify all
//   Test 3: Color value 0 (black), verify
//   Test 4: Color value 15 (light grey), verify max value
//   Test 5: Color RAM independence from screen RAM
//   Test 6: Fill 10 color positions with loop, verify first and last
//
// Color RAM is nibble memory — only bits 0-3 store the color value.
// Upper bits read back as undefined — always mask with $0F.
//
// Uses offset 120 from base to avoid overlap with result area at $0400.
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;
const COLOR_RAM: word = $D800;

// Test area offset: row 3 (120 bytes from start)
// This puts color tests at $D800+120 = $D878, well away from result area
const TEST_OFF: byte = 120;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Write color 1 (white), read back
    // Color RAM is nibble-wide — mask with $0F on read
    // -------------------------------------------------------------------------
    poke(COLOR_RAM + TEST_OFF, 1);
    let readBack: byte = peek(COLOR_RAM + TEST_OFF) & $0F;
    if (readBack == 1) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Write 3 different colors to adjacent positions, verify all
    // 2 = red, 5 = green, 7 = yellow
    // -------------------------------------------------------------------------
    poke(COLOR_RAM + TEST_OFF + 1, 2);
    poke(COLOR_RAM + TEST_OFF + 2, 5);
    poke(COLOR_RAM + TEST_OFF + 3, 7);
    let c1: byte = peek(COLOR_RAM + TEST_OFF + 1) & $0F;
    let c2: byte = peek(COLOR_RAM + TEST_OFF + 2) & $0F;
    let c3: byte = peek(COLOR_RAM + TEST_OFF + 3) & $0F;
    if (c1 == 2) {
        if (c2 == 5) {
            if (c3 == 7) {
                poke(SCREEN + 2 + testNum, 1);
                passed = passed + 1;
            } else {
                poke(SCREEN + 2 + testNum, 0);
            }
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Color value 0 (black), verify
    // -------------------------------------------------------------------------
    poke(COLOR_RAM + TEST_OFF + 4, 0);
    readBack = peek(COLOR_RAM + TEST_OFF + 4) & $0F;
    if (readBack == 0) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Color value 15 (light grey), verify max color value
    // -------------------------------------------------------------------------
    poke(COLOR_RAM + TEST_OFF + 5, 15);
    readBack = peek(COLOR_RAM + TEST_OFF + 5) & $0F;
    if (readBack == 15) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Color RAM independence from screen RAM
    // Write $58 ('X') to screen, color 3 (cyan) to color RAM at same offset.
    // Verify each is independently readable.
    // -------------------------------------------------------------------------
    poke(SCREEN + TEST_OFF + 6, $58);
    poke(COLOR_RAM + TEST_OFF + 6, 3);
    let screenVal: byte = peek(SCREEN + TEST_OFF + 6);
    let colorVal: byte = peek(COLOR_RAM + TEST_OFF + 6) & $0F;
    if (screenVal == $58) {
        if (colorVal == 3) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Fill 10 color positions with loop, verify first and last
    // Writes color values 0..9 to COLOR_RAM+TEST_OFF+10 through +19
    // -------------------------------------------------------------------------
    let i: byte = 0;
    while (i < 10) {
        poke(COLOR_RAM + TEST_OFF + 10 + i, i);
        i = i + 1;
    }
    let firstColor: byte = peek(COLOR_RAM + TEST_OFF + 10) & $0F;
    let lastColor: byte = peek(COLOR_RAM + TEST_OFF + 19) & $0F;
    if (firstColor == 0) {
        if (lastColor == 9) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
