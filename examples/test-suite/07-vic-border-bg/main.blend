module Test.VicBorderBg;

// =============================================================================
// Test: VIC-II Border and Background Color Registers
// =============================================================================
// Exercises VIC-II color registers $D020 (border) and $D021 (background):
//   Test 1: Set border color to 14 (light blue), read back
//   Test 2: Set background color to 6 (blue), read back
//   Test 3: Change border to 2 (red), verify update
//   Test 4: Change background to 0 (black), verify update
//   Test 5: Set both colors, verify independence
//   Test 6: Set border to 15 (light grey), verify max color value
//
// VIC-II registers only use low nibble (bits 0-3) for color.
// Upper nibble reads back as undefined — always mask with $0F.
//
// Results are written to screen memory ($0400):
//   $0400 = total test count
//   $0401 = total passed count
//   $0402+ = per-test pass/fail (1 = pass, 0 = fail)
//
// Completion sentinel: poke($C000, $42)
// =============================================================================

const SCREEN: word = $0400;
const SENTINEL: word = $C000;
const VIC_BORDER: word = $D020;
const VIC_BACKGROUND: word = $D021;

export function main(): void {
    let testNum: byte = 0;
    let passed: byte = 0;

    // -------------------------------------------------------------------------
    // Test 1: Set border color to 14 (light blue), read back
    // -------------------------------------------------------------------------
    poke(VIC_BORDER, 14);
    let readBack: byte = peek(VIC_BORDER);
    let masked: byte = readBack & $0F;
    if (masked == 14) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 2: Set background color to 6 (blue), read back
    // -------------------------------------------------------------------------
    poke(VIC_BACKGROUND, 6);
    readBack = peek(VIC_BACKGROUND);
    masked = readBack & $0F;
    if (masked == 6) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 3: Change border to 2 (red), verify update
    // -------------------------------------------------------------------------
    poke(VIC_BORDER, 2);
    readBack = peek(VIC_BORDER);
    masked = readBack & $0F;
    if (masked == 2) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 4: Change background to 0 (black), verify update
    // -------------------------------------------------------------------------
    poke(VIC_BACKGROUND, 0);
    readBack = peek(VIC_BACKGROUND);
    masked = readBack & $0F;
    if (masked == 0) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 5: Set both colors, verify independence
    // Border = 5 (green), Background = 7 (yellow)
    // -------------------------------------------------------------------------
    poke(VIC_BORDER, 5);
    poke(VIC_BACKGROUND, 7);
    let borderVal: byte = peek(VIC_BORDER) & $0F;
    let bgVal: byte = peek(VIC_BACKGROUND) & $0F;
    if (borderVal == 5) {
        if (bgVal == 7) {
            poke(SCREEN + 2 + testNum, 1);
            passed = passed + 1;
        } else {
            poke(SCREEN + 2 + testNum, 0);
        }
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Test 6: Set border to 15 (light grey), verify max color value
    // -------------------------------------------------------------------------
    poke(VIC_BORDER, 15);
    readBack = peek(VIC_BORDER);
    masked = readBack & $0F;
    if (masked == 15) {
        poke(SCREEN + 2 + testNum, 1);
        passed = passed + 1;
    } else {
        poke(SCREEN + 2 + testNum, 0);
    }
    testNum = testNum + 1;

    // -------------------------------------------------------------------------
    // Write summary to screen memory
    // -------------------------------------------------------------------------
    poke(SCREEN, testNum);
    poke(SCREEN + 1, passed);

    // Signal completion
    poke(SENTINEL, $42);

    // Halt — VICE will capture state after sentinel write
    while (true) {
        barrier();
    }
}
