{
  "schema": 1,
  "mode": "strict",
  "artifacts": {
    "layout": "nested",
    "root": "codeops"
  },
  "quality": {
    "independentReview": true,
    "minimumReviewers": 1,
    "stopOnMajorFinding": true
  },
  "routing": {
    "maxConcurrentAgents": 4,
    "roles": {
      "explorer": {
        "effort": "medium",
        "reasoning": "medium",
        "sandbox": "read-only"
      },
      "executor": {
        "effort": "high",
        "reasoning": "high",
        "sandbox": "workspace-write"
      },
      "demanding-executor": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "workspace-write"
      },
      "correctness-reviewer": {
        "effort": "high",
        "reasoning": "high",
        "sandbox": "read-only"
      },
      "semantics-reviewer": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "sfa-abi-auditor": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "target-platform-auditor": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "machine-code-auditor": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "performance-auditor": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "preflight-auditor": {
        "effort": "high",
        "reasoning": "high",
        "sandbox": "read-only"
      },
      "security-auditor": {
        "effort": "high",
        "reasoning": "high",
        "sandbox": "read-only"
      },
      "design-challenger": {
        "effort": "high",
        "reasoning": "xhigh",
        "sandbox": "read-only"
      },
      "spec-test-author": {
        "effort": "high",
        "reasoning": "high",
        "sandbox": "workspace-write"
      }
    }
  },
  "metrics": {
    "enabled": true
  }
}
